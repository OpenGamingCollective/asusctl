#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk
include /usr/share/dpkg/pkg-info.mk

# Rust's target triple for the host architecture.
RUST_TARGET := $(subst -linux-gnu,-unknown-linux-gnu,$(DEB_HOST_GNU_TYPE))

# Upstream version without any +ds suffix, which names the vendored crates
# tarball when one is shipped alongside the sources. See README.Debian.
UPSTREAM_VER := $(firstword $(subst +, ,$(DEB_VERSION_UPSTREAM)))
VENDOR_TARBALL := vendor_asusctl_$(UPSTREAM_VER).tar.xz
VENDORED := $(wildcard $(VENDOR_TARBALL))

# Build with the distribution's toolchain by absolute path. A rustup shim
# earlier in PATH would otherwise honour upstream's rust-toolchain.toml and pull
# in a different toolchain than the one Build-Depends asks for. Both have to be
# pinned: cargo looks up rustc through PATH unless RUSTC says otherwise.
CARGO := /usr/bin/cargo
export RUSTC := /usr/bin/rustc

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
# Keep the cargo configuration out of the source tree: upstream ships its own
# .cargo/config.toml and writing there would clobber it.
export CARGO_HOME = $(CURDIR)/debian/cargo

# With the vendored crates present the build is offline and pinned by the lock
# file inside the tarball. Without them cargo resolves and downloads as usual,
# which is what a plain build from a git checkout needs.
ifneq (,$(VENDORED))
CARGO_LOCK_FLAGS := --frozen --locked
endif

%:
	dh $@

override_dh_auto_configure:
	mkdir -p debian/cargo
ifneq (,$(VENDORED))
	tar pxf $(VENDOR_TARBALL)
	# Paths in a CARGO_HOME config resolve against the config file, so the
	# vendor directory has to be spelled out absolutely.
	printf '[source.crates-io]\nreplace-with = "vendored-sources"\n\n' > debian/cargo/config.toml
	printf '[source."git+https://github.com/flukejones/sg-rs.git"]\ngit = "https://github.com/flukejones/sg-rs.git"\nreplace-with = "vendored-sources"\n\n' >> debian/cargo/config.toml
	printf '[source."git+https://github.com/slint-ui/slint.git"]\ngit = "https://github.com/slint-ui/slint.git"\nreplace-with = "vendored-sources"\n\n' >> debian/cargo/config.toml
	printf '[source.vendored-sources]\ndirectory = "$(CURDIR)/vendor"\n' >> debian/cargo/config.toml
endif

override_dh_auto_build:
	# Upstream's .cargo/config.toml routes the linker through a wrapper that
	# prefers mold or lld. Force the system linker so the result does not
	# depend on which linkers the build host happens to have installed.
	$(CARGO) build --release $(CARGO_LOCK_FLAGS) \
		--config 'target.$(RUST_TARGET).linker="cc"'

override_dh_install:
	dh_install
	# The compiled message catalogues only exist where the Makefile installs
	# them, which releases up to 6.3.11 do not, so they cannot be listed in
	# rog-control-center.install: dh_install aborts on a pattern that matches
	# nothing.
	if [ -d debian/tmp/usr/share/locale ]; then \
		dh_install -prog-control-center usr/share/locale; \
	fi

override_dh_auto_install:
	make DESTDIR=debian/tmp prefix=/usr install

override_dh_auto_test:
	# The test suites talk to ASUS hardware, so they cannot run on a builder.

override_dh_auto_clean:
	$(CARGO) clean || true
	# Nothing here touches .cargo/, which belongs to upstream.
	rm -rf vendor debian/cargo
ifneq (,$(VENDORED))
	# Only remove the lock when it came out of the vendored tarball. One
	# generated by cargo during a checkout build is left alone: dropping it
	# would silently re-resolve dependencies on every build and defeat any
	# attempt to pin them.
	rm -f Cargo.lock
endif
