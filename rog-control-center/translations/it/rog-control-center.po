#: rog-control-center/ui/pages/about.slint:80
msgctxt "PageAbout"
msgid ""
"A powerful graphical interface for managing ASUS ROG, TUF, and ProArt "
"laptops on Linux."
msgstr ""
"Una potente interfaccia grafica per gestire i laptop ASUS ROG, TUF e ProArt "
"su Linux."

#: rog-control-center/ui/pages/about.slint:88
msgctxt "PageAbout"
msgid ""
"Official GUI for the asusctl toolset — seamless hardware tuning without the "
"command line."
msgstr ""
"GUI ufficiale per la suite di strumenti asusctl: regolazione fluida "
"dell'hardware senza la riga di comando."

#: rog-control-center/ui/pages/about.slint:99
#, fuzzy
msgctxt "PageAbout"
msgid "Key Features"
msgstr "Caratteristiche principali:"

#: rog-control-center/ui/pages/about.slint:108
msgctxt "PageAbout"
msgid "Performance: Switch power profiles and customize fan curves."
msgstr ""
"Prestazioni: cambia i profili di alimentazione e personalizza le curve delle "
"ventole."

#: rog-control-center/ui/pages/about.slint:109
msgctxt "PageAbout"
msgid "Aura Sync: Control keyboard backlighting and LED effects."
msgstr ""
"Aura Sync: controlla la retroilluminazione della tastiera e gli effetti LED."

#: rog-control-center/ui/pages/about.slint:110
msgctxt "PageAbout"
msgid "Battery Health: Set charge limits to extend battery longevity."
msgstr ""
"Salute della batteria: imposta i limiti di carica per prolungare la "
"longevità della batteria."

#: rog-control-center/ui/pages/about.slint:111
msgctxt "PageAbout"
msgid "Display: Toggle Panel Overdrive and refresh rates."
msgstr ""
"Schermo: attiva/disattiva il Panel Overdrive e le frequenze di aggiornamento."

#: rog-control-center/ui/pages/about.slint:112
msgctxt "PageAbout"
msgid "AniMe Matrix: Control AniMe Matrix displays."
msgstr "AniMe Matrix: controlla gli schermi AniMe Matrix."

#: rog-control-center/ui/pages/about.slint:117
#, fuzzy
msgctxt "PageAbout"
msgid "Requirements"
msgstr "Requisiti:"

#: rog-control-center/ui/pages/about.slint:125
msgctxt "PageAbout"
msgid ""
"Kernel 6.19+ recommended (latest kernel always preferred). asusctl/asusd "
"daemon required for hardware control."
msgstr ""
"Kernel 6.19+ consigliato (è sempre preferibile il kernel più recente). Il "
"daemon asusctl/asusd è richiesto per il controllo dell'hardware."

