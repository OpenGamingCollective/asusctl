#: rog-control-center/ui/pages/about.slint:80
msgctxt "PageAbout"
msgid ""
"A powerful graphical interface for managing ASUS ROG, TUF, and ProArt "
"laptops on Linux."
msgstr ""
"Uma poderosa interface gráfica para gerenciar notebooks ASUS ROG, TUF e "
"ProArt no Linux."

#: rog-control-center/ui/pages/about.slint:88
msgctxt "PageAbout"
msgid ""
"Official GUI for the asusctl toolset — seamless hardware tuning without the "
"command line."
msgstr ""
"Interface gráfica oficial do conjunto de ferramentas asusctl — ajuste "
"contínuo de hardware sem a linha de comando."

#: rog-control-center/ui/pages/about.slint:99
#, fuzzy
msgctxt "PageAbout"
msgid "Key Features"
msgstr "Principais Recursos:"

#: rog-control-center/ui/pages/about.slint:108
msgctxt "PageAbout"
msgid "Performance: Switch power profiles and customize fan curves."
msgstr ""
"Desempenho: alterne perfis de energia e personalize as curvas de ventoinha."

#: rog-control-center/ui/pages/about.slint:109
msgctxt "PageAbout"
msgid "Aura Sync: Control keyboard backlighting and LED effects."
msgstr "Aura Sync: controle a retroiluminação do teclado e os efeitos de LED."

#: rog-control-center/ui/pages/about.slint:110
msgctxt "PageAbout"
msgid "Battery Health: Set charge limits to extend battery longevity."
msgstr ""
"Saúde da Bateria: defina limites de carga para prolongar a vida útil da "
"bateria."

#: rog-control-center/ui/pages/about.slint:111
msgctxt "PageAbout"
msgid "Display: Toggle Panel Overdrive and refresh rates."
msgstr "Tela: alterne o Panel Overdrive e as taxas de atualização."

#: rog-control-center/ui/pages/about.slint:112
msgctxt "PageAbout"
msgid "AniMe Matrix: Control AniMe Matrix displays."
msgstr "AniMe Matrix: controle os visores AniMe Matrix."

#: rog-control-center/ui/pages/about.slint:117
#, fuzzy
msgctxt "PageAbout"
msgid "Requirements"
msgstr "Requisitos:"

#: rog-control-center/ui/pages/about.slint:125
msgctxt "PageAbout"
msgid ""
"Kernel 6.19+ recommended (latest kernel always preferred). asusctl/asusd "
"daemon required for hardware control."
msgstr ""
"Kernel 6.19+ recomendado (sempre prefira o kernel mais recente). O daemon "
"asusctl/asusd é necessário para o controle de hardware."

