import { RogProductCard } from "../widgets/cards.slint";
import { RogSlashMark, RogPage } from "../widgets/layout.slint";
import { RogMetric, RogReading, RogStatRow } from "../widgets/metrics.slint";
import { RogModeGrid } from "../widgets/controls.slint";
import { Theme } from "../globals.slint";
import { SystemInfo, TelemetryData, PowerData } from "system.slint";

// NOTE (slint 1.13.1 engine bug): a VerticalLayout used as the FIRST child of
// a HorizontalLayout makes every later cell render empty. The product card is
// therefore a direct Rectangle-based child of the columns row (no VerticalLayout
// wrapper around it). Keep the left cell a Rectangle-like element, not a layout.
export component PageHome inherits RogPage {
    background: Theme.bg-base;
    clip: true;

    // ====== Responsive sizing ======
    // Below ~1000px of page width (narrower laptops) the dashboard tightens:
    // smaller product card, tighter gaps and capped metric cards (compact).
    // Above that everything scales continuously with the page width (which now
    // fills the whole window right of the sidebar) so big monitors grow the
    // product card and metric cards instead of leaving a fixed-width block.
    // The 0.31/0.031/0.017/0.02 coefficients reproduce the old fixed sizes
    // (~360px card / 340px metrics) at a ~1150px page (1366px laptop).
    property <bool> compact: root.width < 1000px;
    property <length> card-side: root.compact ? 300px : Math.min(520px, root.width * 0.31);
    property <length> gap-lg: root.compact ? 24px : Math.min(48px, root.width * 0.031);
    property <length> gap-md: root.compact ? 16px : Math.min(28px, root.width * 0.017);
    property <length> pad-x: root.compact ? 20px : Math.min(44px, root.width * 0.02);
    property <length> right-col: root.width - 2 * root.pad-x - root.card-side - root.gap-lg;
    property <length> metric-max: root.compact ? 300px : Math.min(600px, (root.right-col - root.gap-lg) / 2);

    // ====== Titlebar + Dashboard Root Layout ======
    VerticalLayout {
        spacing: 0px;

        // ====== Titlebar ======
        Rectangle {
            height: 52px;
            background: Theme.bg-base;
            HorizontalLayout {
                padding-left: 32px;
                Text {
                    text: @tr("Home");
                    color: Theme.text-primary;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
            }
        }

        // ====== Dashboard — fills remaining height via vertical-stretch: 1 ======
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: root.pad-x;
            padding-right: root.pad-x;
            padding-top: 12px;
            padding-bottom: 24px;
            spacing: 0px;

            HorizontalLayout {
                spacing: root.gap-lg;

                // Left column: the product card, directly as a (Rectangle-based)
                // child — never wrapped in a VerticalLayout (see note above).
                // Square via the fixed card-side length; no parent geometry.
                product-card := RogProductCard {
                    width: root.card-side;
                    height: root.card-side;
                    name: SystemInfo.product_name != "" ? SystemInfo.product_name : "ROG Laptop";
                    // CPU + GPU straight off the backend — no hardcoded specs.
                    details: [
                        SystemInfo.cpu_name,
                        SystemInfo.has_dgpu ? SystemInfo.dgpu_name : SystemInfo.igpu_name,
                    ];
                }

                // Right column: System Usage + Operation Mode.
                // Content blocks keep their natural height (vertical-stretch: 0);
                // the flex spacers grow instead, so big windows just get taller
                // gaps and nothing overflows on short ones.
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: root.gap-md;

                    // System Usage header
                    Rectangle {
                        height: 24px;
                        vertical-stretch: 0;
                        HorizontalLayout {
                            spacing: 8px;
                            RogSlashMark {}
                            Text {
                                text: @tr("System Usage");
                                color: Theme.text-primary;
                                font-size: 14px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    // Row 1: CPU | GPU
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: root.gap-lg;

                        cpu-metric := RogMetric {
                            horizontal-stretch: 1;
                            max-width: root.metric-max;
                            title: "CPU";
                            RogReading {
                                label: @tr("Frequency");
                                value: TelemetryData.cpu_freq_mhz > 0.0 ? "\{Math.round(TelemetryData.cpu_freq_mhz)} MHz" : "--";
                                progress: TelemetryData.cpu_freq_mhz / 5000.0;
                            }
                            RogReading {
                                label: @tr("Usage");
                                value: TelemetryData.cpu_usage_val >= 0.0 ? "\{Math.round(TelemetryData.cpu_usage_val)} %" : "--";
                                progress: TelemetryData.cpu_usage_val / 100.0;
                            }
                            RogStatRow {
                                label: @tr("Temperature");
                                value: TelemetryData.cpu_temp_val > 0.0 ? "\{Math.round(TelemetryData.cpu_temp_val)} °C" : "--";
                            }
                        }

                        if SystemInfo.has_dgpu: RogMetric {
                            horizontal-stretch: 1;
                            max-width: root.metric-max;
                            title: "dGPU";
                            // Each field judges independently: a suspended dGPU shows
                            // "Suspended" everywhere, but a readable field still shows
                            // even when another one can't be read right now.
                            RogReading {
                                label: @tr("Frequency");
                                value: TelemetryData.dgpu_suspended ? @tr("Suspended") : (TelemetryData.gpu_freq_mhz > 0.0 ? "\{Math.round(TelemetryData.gpu_freq_mhz)} MHz" : "--");
                                progress: TelemetryData.gpu_freq_mhz / 2500.0;
                            }
                            RogReading {
                                label: @tr("Usage");
                                value: TelemetryData.dgpu_suspended ? @tr("Suspended") : (TelemetryData.gpu_usage_val >= 0.0 ? "\{Math.round(TelemetryData.gpu_usage_val)} %" : "--");
                                progress: TelemetryData.gpu_usage_val / 100.0;
                            }
                            RogStatRow {
                                label: @tr("Temperature");
                                value: TelemetryData.dgpu_suspended ? @tr("Suspended") : (TelemetryData.gpu_temp_val > 0.0 ? "\{Math.round(TelemetryData.gpu_temp_val)} °C" : "--");
                            }
                            RogStatRow {
                                label: @tr("TGP");
                                value: TelemetryData.dgpu_suspended ? @tr("Suspended") : (PowerData.nv_tgp.current >= 0 ? "\{Math.round(PowerData.nv_tgp.current)} W" : "--");
                            }
                        }
                    }

                    // Vertical flex gap: grows in fullscreen, keeps the rows apart.
                    Rectangle { vertical-stretch: 1; min-height: 0px; }

                    // Row 2: Fan | Memory
                    HorizontalLayout {
                        vertical-stretch: 0;
                        spacing: root.gap-lg;

                        fan-metric := RogMetric {
                            horizontal-stretch: 1;
                            max-width: root.metric-max;
                            title: @tr("Fan");
                            if TelemetryData.cpu_fan_rpm >= 0: RogReading {
                                label: @tr("CPU Fan");
                                // 0 RPM is a real reading (idle/stopped fan); only the
                                // -1 sentinel from the backend means "no sensor".
                                value: "\{TelemetryData.cpu_fan_rpm} RPM";
                                progress: Math.max(0, TelemetryData.cpu_fan_rpm) / 5000.0;
                            }
                            // Hide the GPU / mid fan rows entirely when the sensor is
                            // absent (-1 sentinel) instead of leaving a "--" placeholder.
                            if TelemetryData.gpu_fan_rpm >= 0: RogReading {
                                label: @tr("GPU Fan");
                                value: "\{TelemetryData.gpu_fan_rpm} RPM";
                                progress: TelemetryData.gpu_fan_rpm / 5000.0;
                            }
                            if TelemetryData.mid_fan_rpm >= 0: RogReading {
                                label: @tr("Mid Fan");
                                value: "\{TelemetryData.mid_fan_rpm} RPM";
                                progress: TelemetryData.mid_fan_rpm / 5000.0;
                            }
                        }

                        mem-metric := RogMetric {
                            horizontal-stretch: 1;
                            max-width: root.metric-max;
                            title: @tr("Memory");
                            RogReading {
                                label: "RAM";
                                value: TelemetryData.ram_usage_val >= 0.0 ? "\{Math.round(TelemetryData.ram_usage_val)} %" : "--";
                                progress: TelemetryData.ram_usage_val / 100.0;
                            }
                        }
                    }

                    // Vertical flex gap before the mode section.
                    Rectangle { vertical-stretch: 1; min-height: 0px; }

                    // Operation Mode section — switches the real asusd platform
                    // profile. Buttons are generated from the device's actual
                    // profiles (platform_profile_indexes), so the count matches
                    // the hardware instead of a hardcoded AC-style set. ev is the
                    // profile enum value (passed to cb_platform_profile); p is the
                    // position (used for layout, label lookup and the active check).
                    if PowerData.platform_profile_indexes.length > 0: VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 12px;

                        Rectangle {
                            height: 24px;
                            HorizontalLayout {
                                spacing: 8px;
                                RogSlashMark {}
                                Text {
                                    text: @tr("Operation Mode");
                                    color: Theme.text-primary;
                                    font-size: 14px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }

                        RogModeGrid {
                            profile-indexes: PowerData.platform_profile_indexes;
                            profile-choices: PowerData.platform_profile_choices;
                            current-profile: PowerData.platform_profile;
                            selected(ev) => {
                                PowerData.cb_platform_profile(ev);
                            }
                        }
                    }
                }
            }
        }
    }
}
