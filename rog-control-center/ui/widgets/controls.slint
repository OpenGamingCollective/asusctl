// Interactive Form Controls
// Contains inputs, sliders, toggles, selectors, and tab bars used across the UI.
import { Theme } from "../globals.slint";
import { ComboBox, Button } from "std-widgets.slint";
import { RogCard } from "cards.slint";



// — Performance mode segmented selector (matches AC ModePivot) —
export component RogModeSelector inherits Rectangle {
    in property <[string]> modes;
    in-out property <int> current;
    callback selected(int);
    height: 46px;
    background: Theme.bg-panel;
    border-radius: Theme.radius-item;
    property <int> focused-index: root.current;
    accessible-role: combobox;
    accessible-label: root.modes[root.current];

    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.current = root.focused-index;
                root.selected(root.current);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.focused-index > 0) {
                root.focused-index -= 1;
                return accept;
            }
            if (event.text == Key.RightArrow && root.focused-index < root.modes.length - 1) {
                root.focused-index += 1;
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        padding: 4px;
        spacing: Theme.space-xs;
        for m[i] in root.modes: Rectangle {
            vertical-stretch: 1;
            border-radius: Theme.radius-item;
            background: i == root.current
                ? Theme.rog-red
                : (ta.has-hover ? Theme.bg-elevated : transparent);
            if i == root.current: Rectangle {
                background: Theme.rog-red;
                border-radius: Theme.radius-item;
                drop-shadow-blur: 12px;
                drop-shadow-color: Theme.rog-red-glow;
            }
            ta := TouchArea {
                clicked => {
                    root.current = i;
                    root.focused-index = i;
                    root.selected(i);
                }
            }
            if fs.has-focus && i == root.focused-index: Rectangle {
                border-radius: Theme.radius-item;
                border-width: 2px;
                border-color: Theme.rog-red;
                background: transparent;
            }
            Text {
                text: m;
                color: i == root.current ? #FFFFFF : Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: i == root.current ? 800 : 500;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}


// — Performance mode grid (large icons + labels) —
export component RogModeGrid inherits Rectangle {
    in property <[int]> profile-indexes;
    in property <[string]> profile-choices;
    in property <int> current-profile;
    callback selected(int);

    height: 104px;

    HorizontalLayout {
        spacing: 0px;
        for ev[p] in root.profile-indexes: Rectangle {
            horizontal-stretch: 1;
            height: 100%;

            accessible-role: button;
            accessible-label: root.profile-choices[p];
            accessible-action-default => { root.selected(ev); }

            if root.current-profile == ev: Rectangle {
                width: 100%; height: 100%;
                background: Theme.mode-selected;
                border-radius: 4px;
                drop-shadow-blur: 16px;
                drop-shadow-color: Theme.rog-red-glow;
            }

            VerticalLayout {
                alignment: center;
                spacing: 10px;
                Image {
                    source: ev == 0 ? @image-url("../images/mode-performance.svg") :
                            ev == 1 ? @image-url("../images/mode-turbo.svg") :
                            ev == 2 ? @image-url("../images/mode-silent.svg") :
                            ev == 3 ? @image-url("../images/mode-silent.svg") :
                            ev == 4 ? @image-url("../images/mode-manual.svg") :
                            @image-url("../images/mode-performance.svg");
                    colorize: root.current-profile == ev ? Theme.text-primary : Theme.text-secondary;
                    height: 32px;
                    image-fit: contain;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.profile-choices[p];
                    color: root.current-profile == ev ? Theme.text-primary : Theme.text-secondary;
                    font-size: 14px;
                    horizontal-alignment: center;
                }
            }

            if root.current-profile == ev: Rectangle {
                y: parent.height - 6px;
                width: 40px; height: 3px;
                x: (parent.width - 40px) / 2;
                background: Theme.rog-red;
                drop-shadow-blur: 10px;
                drop-shadow-offset-y: -4px;
                drop-shadow-color: Theme.rog-red-glow;
            }

            ta := TouchArea {
                width: 100%; height: 100%;
                mouse-cursor: pointer;
                clicked => { root.selected(ev); }
            }

            FocusScope {
                enabled: true;
                key-pressed(event) => {
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.selected(ev);
                        return accept;
                    }
                    reject
                }
                if self.has-focus: Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: 4px;
                    border-width: 2px;
                    border-color: Theme.rog-red;
                    background: transparent;
                }
            }
        }
    }
}


// — Hand-drawn AC slider (grey track + red fill + white round red-bordered handle) —
export component RogSlider inherits Rectangle {
    in property <string> label;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 100;
    in property <string> unit: "";
    in property <bool> enabled: true;
    // When false the device exposes no value for this control: render the row
    // greyed-out with an "N/A" marker instead of hiding it, so users can see
    // the option exists but is unsupported on their hardware.
    in property <bool> available: true;
    // Row width minus the reserve for right-side action chips (help/reset),
    // so the value text and track stay clear of them.
    in property <length> controls-width: 0px;
    callback released(float);
    background: transparent;

    property <float> range: max(0.0001, root.maximum - root.minimum);
    property <float> pct: clamp((root.value - root.minimum) / root.range, 0.0, 1.0);

    VerticalLayout {
        padding: Theme.pad-card;
        spacing: 10px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.label;
                color: root.available ? Theme.text-secondary : Theme.fg-disabled;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.available: Text {
                text: "\{Math.round(root.value)}" + (root.unit == "" ? "" : " " + root.unit);
                color: Theme.rog-red;
                font-size: Theme.font-md;
                font-weight: 700;
                vertical-alignment: center;
            }
            if !root.available: Text {
                text: @tr("not_supported_short" => "N/A");
                color: Theme.fg-disabled;
                font-size: Theme.font-md;
                font-weight: 700;
                vertical-alignment: center;
            }
            if root.controls-width > 0px: Rectangle { width: root.controls-width; }
        }
        track := Rectangle {
            height: 24px;
            // Track + fill positioned absolutely. Do NOT wrap in a layout with
            // `alignment: center`: that is non-stretch mode, which centers the
            // track (ignoring width:100%) and makes the fill look centered.
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 100%;
                height: 4px;
                background: Theme.bg-elevated;
                border-radius: 2px;
                Rectangle {
                    x: 0;
                    width: parent.width * root.pct;
                    height: 100%;
                    background: root.enabled && root.available ? Theme.rog-red : Theme.fg-disabled;
                    border-radius: 2px;
                }
            }
            // handle: white circle + red border
            Rectangle {
                x: root.pct * (parent.width - self.width);
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: #FFFFFF;
                border-width: 2px;
                border-color: root.enabled && root.available ? Theme.rog-red : Theme.fg-disabled;
                drop-shadow-blur: 4px;
                drop-shadow-color: #00000040;
            }
            ta := TouchArea {
                width: 100%;
                height: 100%;
                enabled: root.enabled && root.available;
                mouse-cursor: pointer;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed) {
                        root.set-from-x(self.mouse-x);
                    }
                    if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                        root.released(root.value);
                    }
                }
            }
            accessible-role: slider;
            accessible-label: root.label;
            accessible-value: root.value;
            accessible-value-minimum: root.minimum;
            accessible-value-maximum: root.maximum;
            accessible-enabled: root.enabled && root.available;
            accessible-action-increment => {
                if (root.enabled && root.available) {
                    root.value = Math.min(root.maximum, root.value + root.range / 20.0);
                    root.released(root.value);
                }
            }
            accessible-action-decrement => {
                if (root.enabled && root.available) {
                    root.value = Math.max(root.minimum, root.value - root.range / 20.0);
                    root.released(root.value);
                }
            }
            FocusScope {
                enabled: root.enabled && root.available;
                key-pressed(e) => {
                    if (e.text == Key.RightArrow || e.text == Key.UpArrow) {
                        root.value = Math.min(root.maximum, root.value + root.range / 20.0);
                        return accept;
                    }
                    if (e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                        root.value = Math.max(root.minimum, root.value - root.range / 20.0);
                        return accept;
                    }
                    reject
                }
                key-released(e) => {
                    if (e.text == Key.RightArrow || e.text == Key.UpArrow || e.text == Key.LeftArrow || e.text == Key.DownArrow) {
                        root.released(root.value);
                        return accept;
                    }
                    reject
                }
                if self.has-focus: Rectangle {
                    x: root.pct * (parent.width - 16px) - 3px;
                    y: (parent.height - 16px) / 2 - 3px;
                    width: 22px;
                    height: 22px;
                    border-radius: 11px;
                    border-width: 2px;
                    border-color: Theme.rog-red;
                    background: transparent;
                }
            }
        }
    }

    function set-from-x(x: length) {
        // Map the pointer onto the handle's actual travel (track minus the
        // 16px handle), centered on the handle — so clicking the handle
        // doesn't jump it and both ends are reachable.
        root.value = root.minimum + clamp((x - 8px) / (track.width - 16px), 0.0, 1.0) * root.range;
    }
}


// — Power-limit slider: AC slider with optional help popup and reset-to-default.
//   `available` / "N/A" handling lives in RogSlider itself. —
export component RogPowerSlider inherits RogSlider {
    in property <string> help-text: "";
    in property <bool> has-reset: false;
    callback do-reset();
    controls-width: (root.has-reset && root.available ? 34px : 0px) + (root.help-text != "" ? 34px : 0px);

    help-popup := PopupWindow {
        x: root.x + root.width - self.width - 24px;
        y: root.y - self.height - 8px;
        Rectangle {
            drop-shadow-blur: 10px;
            drop-shadow-color: black;
            border-radius: Theme.radius-item;
            border-color: Theme.border;
            background: Theme.bg-card;
            width: content.preferred-width;
            height: content.preferred-height;
            content := VerticalLayout {
                padding: Theme.pad-card;
                spacing: 10px;
                Text {
                    max-width: 420px;
                    font-size: Theme.font-sm;
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-primary;
                    text: root.help-text;
                }
                Button {
                    text: @tr("OK");
                    clicked => { help-popup.close(); }
                }
            }
        }
    }

    reset-popup := PopupWindow {
        x: root.x + root.width - self.width - 24px;
        y: root.y - self.height - 8px;
        Rectangle {
            drop-shadow-blur: 10px;
            drop-shadow-color: black;
            border-radius: Theme.radius-item;
            border-color: Theme.border;
            background: Theme.bg-card;
            width: reset-content.preferred-width;
            height: reset-content.preferred-height;
            reset-content := VerticalLayout {
                padding: Theme.pad-card;
                spacing: 10px;
                Text {
                    max-width: 420px;
                    font-size: Theme.font-sm;
                    wrap: TextWrap.word-wrap;
                    color: Theme.text-primary;
                    text: @tr("confirm_reset" => "Are you sure you want to reset this?");
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: @tr("Cancel");
                        clicked => { reset-popup.close(); }
                    }
                    Button {
                        text: @tr("Reset");
                        clicked => {
                            reset-popup.close();
                            root.do-reset();
                        }
                    }
                }
            }
        }
    }

    // Action chips (help / reset) anchored at the far right of the label row;
    // the slider row keeps `controls-width` clear so nothing overlaps them.
    chips := HorizontalLayout {
        x: root.width - self.preferred-width - Theme.pad-card;
        y: Theme.pad-card - 2px;
        spacing: 8px;
        if root.has-reset && root.available: Rectangle {
            width: 26px;
            height: 22px;
            border-radius: Theme.radius-item;
            background: reset-ta.has-hover ? Theme.bg-elevated : transparent;
            reset-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? pointer : default;
                clicked => { reset-popup.show(); }
            }
            accessible-role: button;
            accessible-label: @tr("Reset {}", root.label);
            accessible-enabled: root.enabled;
            accessible-action-default => {
                if (root.enabled) {
                    reset-popup.show();
                }
            }
            FocusScope {
                width: 100%; height: 100%;
                enabled: root.enabled;
                key-pressed(e) => {
                    if (e.text == Key.Return || e.text == Key.Space) {
                        reset-popup.show();
                        return accept;
                    }
                    reject
                }
                if self.has-focus: Rectangle {
                    border-radius: Theme.radius-item;
                    border-width: 2px;
                    border-color: Theme.rog-red;
                    background: transparent;
                }
            }
            Text {
                text: "↺";
                color: root.enabled ? Theme.text-secondary : Theme.fg-disabled;
                font-size: Theme.font-md;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.help-text != "": Rectangle {
            width: 26px;
            height: 22px;
            border-radius: Theme.radius-item;
            background: help-ta.has-hover ? Theme.bg-elevated : transparent;
            help-ta := TouchArea {
                clicked => { help-popup.show(); }
            }
            accessible-role: button;
            accessible-label: @tr("Help for {}", root.label);
            accessible-action-default => {
                help-popup.show();
            }
            FocusScope {
                width: 100%; height: 100%;
                enabled: true;
                key-pressed(e) => {
                    if (e.text == Key.Return || e.text == Key.Space) {
                        help-popup.show();
                        return accept;
                    }
                    reject
                }
                if self.has-focus: Rectangle {
                    border-radius: Theme.radius-item;
                    border-width: 2px;
                    border-color: Theme.rog-red;
                    background: transparent;
                }
            }
            Text {
                text: "?";
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}


// — Hand-drawn AC toggle (ON red / OFF grey, rounded pill) —
export component RogToggle inherits Rectangle {
    in property <string> label;
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // compact: label sits right next to the switch (no stretch spacer), for
    // toolbars where the toggle isn't a full-width settings row.
    in property <bool> compact: false;
    callback toggled(bool);
    background: transparent;
    // compact: take only the content width; otherwise fill the row so the
    // switch sits at the far right (settings-row style).
    horizontal-stretch: root.compact ? 0 : 1;
    // Screen readers see a labelled checkbox; Space/Return toggles it.
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    // Center the switch row vertically so a caller can place this in a taller
    // row (e.g. height: 46px) without the switch sticking to the top.
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: root.compact ? 0px : Theme.pad-card;
            padding-right: root.compact ? 0px : Theme.pad-card;
            spacing: root.compact ? 8px : 0px;
            Text {
                text: root.label;
                color: root.enabled ? Theme.text-primary : Theme.text-dim;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
            if !root.compact: Rectangle { horizontal-stretch: 1; }
            tg := Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                background: root.checked ? (root.enabled ? Theme.rog-red : Theme.fg-disabled) : Theme.toggle-off;
                ta := TouchArea {
                    enabled: root.enabled;
                    clicked => {
                        root.checked = !root.checked;
                        root.toggled(root.checked);
                    }
                }
                FocusScope {
                    enabled: root.enabled;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.checked = !root.checked;
                            root.toggled(root.checked);
                            return accept;
                        }
                        reject
                    }
                    if self.has-focus: Rectangle {
                        x: -3px; y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 15px;
                        border-width: 2px;
                        border-color: Theme.rog-red;
                        background: transparent;
                    }
                }
                Rectangle {
                    x: root.checked ? parent.width - self.width - 3px : 3px;
                    animate x { duration: 120ms; easing: ease-in-out; }
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: Theme.fg-normal;
                }
            }
        }
    }
}


// — int switch (for panel_overdrive / boot_sound etc., int 0/1) —
export component RogToggleInt inherits Rectangle {
    in property <string> label;
    in-out property <int> checked-int;
    in property <bool> enabled: true;
    // Unsupported on this device: grey the row out and lock the switch off.
    in property <bool> available: true;
    // compact: label + switch sit together (no stretch spacer), for grids
    // where the toggle is centered in a cell rather than filling a full row.
    in property <bool> compact: false;
    callback toggled(int);
    background: transparent;
    horizontal-stretch: root.compact ? 0 : 1;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked-int != 0;
    accessible-action-default => {
        if (root.enabled && root.available) {
            root.checked-int = root.checked-int != 0 ? 0 : 1;
            root.toggled(root.checked-int);
        }
    }
    // Center the switch row vertically (see RogToggle).
    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            padding-left: root.compact ? 0px : Theme.pad-card;
            padding-right: root.compact ? 0px : Theme.pad-card;
            spacing: root.compact ? 10px : 0px;
            Text {
                text: root.label;
                color: root.enabled && root.available ? Theme.text-primary : Theme.text-dim;
                font-size: Theme.font-sm;
                vertical-alignment: center;
            }
            if !root.compact: Rectangle { horizontal-stretch: 1; }
            tg := Rectangle {
                width: 44px;
                height: 24px;
                border-radius: 12px;
                background: root.checked-int != 0 && root.available ? (root.enabled ? Theme.rog-red : Theme.fg-disabled) : Theme.toggle-off;
                ta := TouchArea {
                    enabled: root.enabled && root.available;
                    clicked => {
                        root.checked-int = root.checked-int != 0 ? 0 : 1;
                        root.toggled(root.checked-int);
                    }
                }
                FocusScope {
                    enabled: root.enabled && root.available;
                    key-pressed(event) => {
                        if (event.text == Key.Return || event.text == Key.Space) {
                            root.checked-int = root.checked-int != 0 ? 0 : 1;
                            root.toggled(root.checked-int);
                            return accept;
                        }
                        reject
                    }
                    if self.has-focus: Rectangle {
                        x: -3px; y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: 15px;
                        border-width: 2px;
                        border-color: Theme.rog-red;
                        background: transparent;
                    }
                }
                Rectangle {
                    x: root.checked-int != 0 ? parent.width - self.width - 3px : 3px;
                    y: 3px;
                    width: 18px;
                    height: 18px;
                    border-radius: 9px;
                    background: #FFFFFF;
                }
            }
        }
    }
}


// — Dropdown row (MiniLED / EPP) —
export component RogDropdownRow inherits Rectangle {
    in property <string> label;
    in-out property <int> current-index;
    in-out property <string> current-value;
    in-out property <[string]> model;
    in property <length> combo-min-width: 180px;
    in property <bool> enabled: true;
    callback selected(int);
    background: transparent;
    opacity: root.enabled ? 1.0 : 0.4;
    HorizontalLayout {
        padding-left: Theme.pad-card;
        padding-right: Theme.pad-card;
        Text {
            text: root.label;
            color: root.enabled ? Theme.text-secondary : Theme.text-dim;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        if root.enabled: ComboBox {
            min-width: root.combo-min-width;
            current-index <=> root.current-index;
            current-value <=> root.current-value;
            model <=> root.model;
            selected => { root.selected(root.current-index); }
        }
        if !root.enabled: Text {
            text: @tr("Not available");
            color: Theme.text-dim;
            font-size: Theme.font-sm;
            vertical-alignment: center;
        }
    }
}


// ============================================================
//  System Settings Page Components — AC multi-tab layout
// ============================================================

// —— Tab bar: horizontal row of tabs with red underline on active ——
export component RogTabBar inherits Rectangle {
    in property <[string]> tabs;
    in property <[bool]> tab-enabled: [];
    in-out property <int> active: 0;
    callback tab-changed(int);
    height: 44px;
    background: transparent;

    property <int> focused-index: root.active;
    accessible-role: tab;
    accessible-label: root.tabs[root.active];

    fs := FocusScope {
        width: 100%; height: 100%;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.focused-index < root.tabs.length
                    && (root.focused-index >= root.tab-enabled.length
                        || root.tab-enabled[root.focused-index])) {
                    root.active = root.focused-index;
                    root.tab-changed(root.active);
                }
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                // NOTE: Slint does not yet support imperative `while` or `for` loops in callbacks.
                // We manually unroll the search to skip over consecutive disabled tabs (max 5 skips).
                if (root.focused-index >= 1 && (root.focused-index - 1 >= root.tab-enabled.length || root.tab-enabled[root.focused-index - 1])) {
                    root.focused-index -= 1;
                } else if (root.focused-index >= 2 && (root.focused-index - 2 >= root.tab-enabled.length || root.tab-enabled[root.focused-index - 2])) {
                    root.focused-index -= 2;
                } else if (root.focused-index >= 3 && (root.focused-index - 3 >= root.tab-enabled.length || root.tab-enabled[root.focused-index - 3])) {
                    root.focused-index -= 3;
                } else if (root.focused-index >= 4 && (root.focused-index - 4 >= root.tab-enabled.length || root.tab-enabled[root.focused-index - 4])) {
                    root.focused-index -= 4;
                } else if (root.focused-index >= 5 && (root.focused-index - 5 >= root.tab-enabled.length || root.tab-enabled[root.focused-index - 5])) {
                    root.focused-index -= 5;
                }
                return accept;
            }
            if (event.text == Key.RightArrow) {
                if (root.focused-index + 1 < root.tabs.length && (root.focused-index + 1 >= root.tab-enabled.length || root.tab-enabled[root.focused-index + 1])) {
                    root.focused-index += 1;
                } else if (root.focused-index + 2 < root.tabs.length && (root.focused-index + 2 >= root.tab-enabled.length || root.tab-enabled[root.focused-index + 2])) {
                    root.focused-index += 2;
                } else if (root.focused-index + 3 < root.tabs.length && (root.focused-index + 3 >= root.tab-enabled.length || root.tab-enabled[root.focused-index + 3])) {
                    root.focused-index += 3;
                } else if (root.focused-index + 4 < root.tabs.length && (root.focused-index + 4 >= root.tab-enabled.length || root.tab-enabled[root.focused-index + 4])) {
                    root.focused-index += 4;
                } else if (root.focused-index + 5 < root.tabs.length && (root.focused-index + 5 >= root.tab-enabled.length || root.tab-enabled[root.focused-index + 5])) {
                    root.focused-index += 5;
                }
                return accept;
            }
            reject
        }
    }

    HorizontalLayout {
        spacing: 0px;
        for t[i] in root.tabs: Rectangle {
            height: 100%;
            min-width: 90px;
            vertical-stretch: 1;
            background: transparent;

            // Active tab: red bottom border
            if i == root.active: Rectangle {
                x: 0px;
                y: parent.height - 2px;
                width: 100%;
                height: 2px;
                background: Theme.rog-red;
            }

            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;
                Text {
                    text: t;
                    color: (i >= root.tab-enabled.length || root.tab-enabled[i])
                        ? (i == root.active ? Theme.text-primary : Theme.text-secondary)
                        : Theme.fg-disabled;
                    font-size: 14px;
                    font-weight: i == root.active ? 600 : 400;
                    horizontal-alignment: center;
                }
            }

            ta := TouchArea {
                enabled: i >= root.tab-enabled.length || root.tab-enabled[i];
                clicked => {
                    root.active = i;
                    root.focused-index = i;
                    root.tab-changed(i);
                }
            }
            if fs.has-focus && i == root.focused-index: Rectangle {
                x: 2px; y: 2px;
                width: parent.width - 4px; height: parent.height - 4px;
                border-radius: 4px;
                border-width: 2px;
                border-color: Theme.rog-red;
                background: transparent;
            }

            // Hover effect
            if ta.has-hover && i != root.active: Rectangle {
                y: parent.height - 2px;
                width: 100%;
                height: 1px;
                background: Theme.line-soft;
            }
        }
        Rectangle { horizontal-stretch: 1; } // push tabs left
    }
}

