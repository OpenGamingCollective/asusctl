// rog-control-center — AC-style sidebar (matched against the AC f001 screenshot)
// Narrow icon bar (~56px): ROG logo + icon nav + quit button.
// Selected state: #5A2025 dark-red fill + a left red indicator bar.
//
// New menu entry = one NavItemData row in `model` (no separate icon array to
// keep in sync). The for-repeater scales automatically.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../globals.slint";

// One nav entry: title (i18n + a11y label) + icon. Add new pages here only.
export struct NavItemData {
    title: string,
    icon: image,
}

// — Single nav item: icon + selected red bar —
export component NavItem inherits Rectangle {
    in property <bool> selected: false;
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();
    width: 100%;
    height: 48px;
    accessible-role: tab;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    background: root.selected ? Theme.sidebar-selected : transparent;

    // Left red indicator (only when selected)
    if root.selected: Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 32px;
        background: Theme.rog-red;
        border-radius: 1.5px;
    }

    // Icon (centered)
    Image {
        source: root.icon;
        colorize: root.enabled ? (root.selected ? Theme.text-primary : Theme.text-secondary) : Theme.fg-disabled;
        width: 22px;
        height: 22px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component HorizontalDivider inherits Rectangle {
    height: 1px;
    width: 100%;
    background: Theme.divider;
}

// — AC-style sidebar —
export component SideBar inherits Rectangle {
    in property <[NavItemData]> model;
    in property <[bool]> available;
    in property <bool> is_tuf: false;
    out property <int> current-item: 0;

    background: Theme.sidebar-bg;
    width: 56px;
    clip: true;

    VerticalLayout {
        spacing: 2px;
        padding-top: 12px;
        padding-bottom: 8px;

        // — ROG logo —
        Rectangle {
            height: 64px;
            width: 100%;
            background: transparent;
            Image {
                source: @image-url("../../data/rog-sidebar-logo.png");
                width: 36px;
                height: 36px;
                horizontal-alignment: center;
                vertical-alignment: center;
                image-fit: contain;
            }
        }

        // Divider
        HorizontalDivider { }

        // — Nav item list. Scrolls vertically when the window is too short to
        // fit every entry, instead of clipping or collapsing the icons. The logo
        // stays pinned at top; the list fills the remaining space. —
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                accessible-role: tab-list;
                accessible-orientation: Orientation.vertical;
                accessible-item-count: root.model.length;
                for item[index] in root.model: NavItem {
                    enabled: index < root.available.length && root.available[index];
                    icon: item.icon;
                    accessible-label: item.title;
                    selected: index == root.current-item;
                    clicked => { root.current-item = index; }
                }
            }
        }
    }
}
