// rog-control-center — AC-style sidebar (matched against the AC f001 screenshot)
// Collapsed = 56px icon rail; hovering (or pinning via the menu button) slides
// it open to a labelled rail with a smooth width + label-fade animation.
// Selected state: #5A2025 dark-red fill + a left red indicator bar.
//
// New menu entry = one NavItemData row in `model` (no separate icon array to
// keep in sync). The for-repeater scales automatically.
import { ScrollView } from "std-widgets.slint";
import { Theme } from "../globals.slint";

// One nav entry: title (i18n + a11y label) + icon. Add new pages here only.
export struct NavItemData {
    title: string,
    icon: image,
}

// — Single nav item: icon + (expanded) label + selected red bar —
export component NavItem inherits Rectangle {
    in property <bool> selected: false;
    in property <image> icon;
    in property <string> label: "";
    // 0 = icon-only rail, 1 = labelled rail. Drives the label fade so text
    // doesn't pop in while the rail is still sliding open.
    in property <float> expand: 0.0;
    in property <bool> enabled: true;
    // false = the page's backend interface is absent on this device (no Slash,
    // no AniMe, ...). Hidden outright: a control the user can never use is just
    // noise. The for-repeater skips it and the remaining items reflow up.
    in property <bool> available: true;
    callback clicked();
    width: 100%;
    height: 48px;
    visible: root.available;
    accessible-role: tab;
    accessible-item-selectable: true;
    accessible-item-selected: root.selected;
    accessible-action-default => { root.clicked(); }
    background: root.selected ? Theme.sidebar-selected : (ta.has-hover && root.enabled ? Theme.sidebar-hover : transparent);
    clip: true;

    // Left red indicator (only when selected)
    if root.selected: Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 3px;
        height: 32px;
        background: Theme.rog-red;
        border-radius: 1.5px;
    }

    // Icon: centred on the 56px rail in both states, so it never shifts while
    // the rail width animates. x is fixed to the collapsed-rail centre.
    Image {
        source: root.icon;
        colorize: root.enabled ? (root.selected ? Theme.text-primary : Theme.text-secondary) : Theme.fg-disabled;
        width: 22px;
        height: 22px;
        x: (56px - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
    }

    // Label: fades + slides in once the rail is mostly open, hidden collapsed.
    Text {
        text: root.label;
        color: root.enabled ? (root.selected ? Theme.text-primary : Theme.text-secondary) : Theme.fg-disabled;
        font-size: Theme.font-sm;
        font-weight: root.selected ? 600 : 400;
        vertical-alignment: center;
        x: 56px;
        width: parent.width - 56px;
        opacity: root.expand;
        overflow: elide;
    }

    // Keyboard access: focusable + Enter/Space activates, focus ring shown while
    // focused. Declared BEFORE the TouchArea so it sits lower in z-order and
    // never swallows pointer clicks (it only handles keys when focused).
    FocusScope {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.clicked();
                return accept;
            }
            reject
        }
        // Focus ring (2px red outline inside the item bounds).
        if self.has-focus: Rectangle {
            x: 2px; y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            border-radius: 4px;
            border-width: 2px;
            border-color: Theme.rog-red;
            background: transparent;
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component HorizontalDivider inherits Rectangle {
    height: 1px;
    width: 100%;
    background: Theme.divider;
}

// — AC-style collapsible sidebar —
export component SideBar inherits Rectangle {
    in property <[NavItemData]> model;
    in property <[bool]> available;
    out property <int> current-item: 0;

    // Expanded state is driven solely by the bottom toggle button (pinned).
    // No hover expansion: the rail stays put until the user explicitly toggles.
    in-out property <bool> pinned: false;
    property <bool> expanded: root.pinned;

    in property <length> collapsed-width: 56px;
    in property <length> expanded-width: 208px;

    background: Theme.sidebar-bg;
    width: root.expanded ? root.expanded-width : root.collapsed-width;
    clip: true;

    // The slide: animate the rail width, and a 0..1 factor for the label fade.
    property <float> expand-anim: root.expanded ? 1.0 : 0.0;
    animate width { duration: 200ms; easing: cubic-bezier(0.22, 0.61, 0.36, 1); }
    animate expand-anim { duration: 220ms; easing: ease-out; }

    VerticalLayout {
        spacing: 2px;
        padding-top: 12px;
        padding-bottom: 8px;

        // — Header: ROG logo (collapsed) / logo + wordmark (expanded) —
        Rectangle {
            height: 64px;
            width: 100%;
            background: transparent;
            Image {
                source: @image-url("../../data/rog-sidebar-logo.png");
                width: 36px;
                height: 36px;
                x: (56px - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
            Text {
                text: "ROG Control";
                color: Theme.text-primary;
                font-size: 15px;
                font-weight: 700;
                vertical-alignment: center;
                x: 56px;
                opacity: root.expand-anim;
            }
        }

        // Divider
        HorizontalDivider { }

        // — Nav item list. Scrolls vertically when the window is too short to
        // fit every entry, instead of clipping or collapsing the icons. The logo
        // stays pinned at top; the list fills the remaining space. —
        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 2px;
                alignment: start;
                accessible-role: tab-list;
                accessible-orientation: Orientation.vertical;
                accessible-item-count: root.model.length;
                for item[index] in root.model: Rectangle {
                    // Entries whose backend is absent on this device are skipped
                    // entirely (height 0), so they don't leave a blank slot.
                    property <bool> avail: index < root.available.length && root.available[index];
                    width: 100%;
                    height: avail ? 48px : 0px;
                    visible: avail;
                    if avail: NavItem {
                        width: 100%;
                        height: 100%;
                        icon: item.icon;
                        label: item.title;
                        expand: root.expand-anim;
                        accessible-label: item.title;
                        selected: index == root.current-item;
                        clicked => { root.current-item = index; }
                    }
                }
            }
        }

        // — Pin / collapse toggle at the bottom —
        HorizontalDivider { }
        Rectangle {
            height: 44px;
            width: 100%;
            background: pin-ta.has-hover ? Theme.sidebar-selected : transparent;
            Image {
                source: @image-url("../images/nav-expand.svg");
                colorize: root.pinned ? Theme.rog-red : Theme.text-secondary;
                width: 20px;
                height: 20px;
                x: (56px - self.width) / 2;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
            }
            Text {
                text: root.pinned ? @tr("Collapse") : @tr("Expand");
                color: Theme.text-secondary;
                font-size: Theme.font-sm;
                vertical-alignment: center;
                x: 56px;
                opacity: root.expand-anim;
            }
            pin-ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.pinned = !root.pinned; }
            }
        }
    }
}
